# Copy to .env (git-ignored) and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com -> Get API key). Empty = offline mode.
GEMINI_API_KEY=
# Optional: model name (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: RentCast key for scripts/fetch_rentcast.py (else it asks, input hidden)
RENTCAST_API_KEY=

# Optional: force offline agent even when a key is set (1 = offline)
RENTRADAR_OFFLINE=0
